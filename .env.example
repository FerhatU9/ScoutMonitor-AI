
# ScoutMonitor AI - Example Configuration
# Copy this file to .env and enter your own credentials.

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scoutmonitor_portfolio_test
DB_USER=postgres
DB_PASSWORD=your_database_password

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Sportmonks Football API
SPORTMONKS_API_TOKEN=your_sportmonks_api_token
