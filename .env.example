
# ScoutMonitor AI - local environment configuration template
# Copy to .env for local use. Never commit your filled-in .env file.
# The values below are examples, not production credentials.

# Local PostgreSQL development database (use a new, empty demo database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scoutmonitor_demo
DB_USER=postgres
DB_PASSWORD=your_database_password

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Sportmonks Football API (subject to provider access and licensing)
SPORTMONKS_API_TOKEN=your_sportmonks_api_token

# OpenID Connect provider for protected organization endpoints
# Replace ALL values below with an authorized identity provider's settings.
# These placeholders do not enable real customer sign-in.
OIDC_ISSUER=https://identity-provider.example
OIDC_AUDIENCE=scoutmonitor-api
OIDC_JWKS_URL=https://identity-provider.example/.well-known/jwks.json
